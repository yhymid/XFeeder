{
  "Settings": {
    "Logs": false,
    "DebugExpert": false
  },
  "Auth": {
    "Token": "${DISCORD_AUTH_TOKEN}",
    "x-super-properties": "${DISCORD_X_SUPER_PROPERTIES}",
    "cookie": "${DISCORD_COOKIE}"
  },
  "Telegram": {
    "Enabled": true,
    "BotToken": "${TELEGRAM_BOT_TOKEN}",
    "ChatID": "${TELEGRAM_CHAT_ID}",
    "MessageThreadID": null,
    "DisableWebPagePreview": false,
    "TimeoutMs": 15000
  },
  "Proxy": {
    "Enabled": false,
    "Url": "http://127.0.0.1:8080"
  },
  "Scrapling": {
    "Enabled": true,
    "ForceGlobal": false,
    "AutoFallback": true,
    "AutoUseShellForAdvancedOptions": true,
    "PersistentBrowserSessions": true,
    "PreferredMode": "cli",
    "FallbackStatusCodes": [
      403,
      429,
      503
    ],
    "AntiBot": {
      "Enabled": true,
      "LogDecisions": false,
      "PreferStealthOnSignals": true,
      "ModeOrder": [
        "get",
        "fetch",
        "stealthy-fetch"
      ],
      "StatusCodes": [
        403,
        429,
        503
      ],
      "HeaderKeys": [
        "cf-mitigated",
        "x-datadome",
        "x-akamai-transformed",
        "akamai-grn",
        "x-sucuri-id"
      ],
      "BodySignatures": [
        "just a moment",
        "attention required",
        "turnstile",
        "datadome",
        "challenge page",
        "captcha",
        "access denied"
      ],
      "TitleSignatures": [
        "just a moment",
        "attention required",
        "error 1020",
        "access denied",
        "verify you are human"
      ],
      "MinBodyBytes": 200,
      "MinConfidence": 40,
      "TreatCloudflareAsSignal": true,
      "MaxAttempts": 3
    },
    "DefaultOptions": {
      "runtimeMode": "cli",
      "extractMode": "stealthy-fetch",
      "mode": "stealthy-fetch",
      "headers": {},
      "extraHeaders": {},
      "cookies": "",
      "auth": null,
      "params": {},
      "data": "",
      "jsonData": null,
      "followRedirects": true,
      "verify": true,
      "impersonate": null,
      "stealthyHeaders": true,
      "aiTargeted": false,
      "headless": true,
      "timeoutSeconds": 30,
      "timeoutMs": 30000,
      "maxPages": null,
      "wait": 0,
      "networkIdle": false,
      "disableResources": false,
      "dnsOverHttps": false,
      "waitSelector": null,
      "proxy": null,
      "proxyRotator": null,
      "blockAds": false,
      "blockWebrtc": false,
      "solveCloudflare": false,
      "allowWebgl": true,
      "hideCanvas": false,
      "realChrome": false,
      "locale": null
    },
    "PerUrlConfig": {
      "https://protected-site.com/feed": {
        "enabled": true,
        "runtimeMode": "cli",
        "extractMode": "stealthy-fetch",
        "mode": "stealthy-fetch",
        "solveCloudflare": true,
        "headless": true,
        "timeoutMs": 45000,
        "wait": 1000,
        "networkIdle": true,
        "disableResources": true,
        "dnsOverHttps": true,
        "waitSelector": ".content-ready",
        "proxy": null,
        "blockAds": true,
        "blockWebrtc": true,
        "allowWebgl": false,
        "hideCanvas": true,
        "realChrome": false,
        "locale": "en-US",
        "maxPages": 2,
        "proxyRotator": null,
        "extraHeaders": {
          "Accept-Language": "en-US,en;q=0.9"
        },
        "antiBot": {
          "ModeOrder": [
            "fetch",
            "stealthy-fetch"
          ],
          "MinBodyBytes": 500,
          "MinConfidence": 50
        },
        "htmlParseOptions": {
          "itemSelector": "article",
          "titleSelector": "h2",
          "linkSelector": "a.read-more"
        }
      }
    }
  },
  "ChannelDefaults": {
    "TimeChecker": 30,
    "RequestSend": 5
  },
  "channels": {
    "main": {
      "Webhook": "${DISCORD_WEBHOOK_MAIN}",
      "Telegram": {
        "MessageThreadID": null
      },
      "Feeds": [
        "https://example.com/rss",
        "https://example.org/feed.xml",
        "https://www.youtube.com/feeds/videos.xml?channel_id=UC_CHANNEL_ID"
      ]
    }
  },
  "channels2": {
    "dev": {
      "Webhook": "${DISCORD_WEBHOOK_DEV}",
      "Telegram": {
        "ChatID": "${TELEGRAM_CHAT_ID_DEV}",
        "MessageThreadID": null
      },
      "Feeds": [
        "https://example.org/project/commits.atom"
      ],
      "TimeChecker": 60,
      "RequestSend": 2
    }
  }
}
