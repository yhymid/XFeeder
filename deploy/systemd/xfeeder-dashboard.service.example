[Unit]
Description=XFeeder dashboard
# Starts, stops and restarts together with the worker.
After=network-online.target xfeeder.service
Wants=network-online.target
PartOf=xfeeder.service

[Service]
Type=simple
WorkingDirectory=/var/lib/xfeeder
ExecStart=/usr/local/bin/xfeeder dashboard --data-dir /var/lib/xfeeder
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=45
StateDirectory=xfeeder
UMask=0077
User=xfeeder
Group=xfeeder
Environment=XFEEDER_DASHBOARD_HOST=127.0.0.1
Environment=XFEEDER_DASHBOARD_PORT=3000
# XFEEDER_DASHBOARD_PASSWORD, XFEEDER_DASHBOARD_PUBLIC_ORIGIN
EnvironmentFile=-/etc/xfeeder/dashboard.env

[Install]
WantedBy=xfeeder.service
