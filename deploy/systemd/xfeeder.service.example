[Unit]
Description=XFeeder worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/lib/xfeeder
ExecStart=/usr/bin/node /opt/xfeeder/main.js --config /var/lib/xfeeder/config.json --cache /var/lib/xfeeder/cache.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGTERM
StateDirectory=xfeeder
UMask=0077
User=xfeeder
Group=xfeeder
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
