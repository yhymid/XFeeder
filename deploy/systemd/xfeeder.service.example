[Unit]
Description=XFeeder worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/lib/xfeeder
ExecStart=/usr/local/bin/xfeeder --config /var/lib/xfeeder/config.json --cache /var/lib/xfeeder/cache.json
Restart=on-failure
RestartSec=5
# SIGTERM: finish running channels within network.shutdownGraceMs, save state.
KillSignal=SIGTERM
TimeoutStopSec=45
StateDirectory=xfeeder
UMask=0077
User=xfeeder
Group=xfeeder
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
